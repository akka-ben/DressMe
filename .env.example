BACKEND_APP_NAME=DressMe API
BACKEND_ENV=development
BACKEND_DEBUG=true
BACKEND_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_AUTO_CREATE_INDEXES=true
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=dressme
REDIS_URL=redis://redis:6379/0

API_V1_PREFIX=/api/v1
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8081

EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dressme.app
SMTP_FROM_NAME=DressMe
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dressme
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_AI=true
TURN_URL=turn:localhost:3478
TURN_USERNAME=dressme
TURN_PASSWORD=dressme-secret
MOBILE_USE_MOCKS=false
MOBILE_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.0.197:8000/api/v1
